{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "files": {
    "includes": [
      "src/**",
      "data/**",
      "build.mjs",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "!apps/**",
      "!data/*.csv",
      "!data/*.duckdb",
      "!data/*.sql",
      "!data/*.md"
    ]
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  }
}
