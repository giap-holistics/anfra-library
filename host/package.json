{
  "name": "anfra-host-example",
  "version": "0.1.0",
  "private": true,
  "description": "A custom host for anfra Data Apps, built on @holistics/anfra-sdk, in place of anfra serve's builtin appserve.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,page -c blue,magenta \"pnpm dev:server\" \"pnpm dev:page\"",
    "dev:server": "tsx watch --clear-screen=false server/main.ts",
    "dev:page": "vite",
    "dev:anfra": "cd \"${ANFRA_REPO:-../demo-data}\" && ANFRA_SITE_URL=\"${ANFRA_SITE_URL:-http://localhost:5173}\" anfra serve --no-apps",
    "build": "vite build && tsc -b tsconfig.server.json --force",
    "start": "NODE_ENV=production node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.page.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test 'server/**/*.test.ts' 'src/**/*.test.ts'",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@holistics/anfra-sdk": "0.11.1",
    "@hono/node-server": "^2.1.4",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
